{
  "manifest_version": 3,
  "name": "ExtensionLedger - Extension Security Auditor",
  "short_name": "ExtensionLedger",
  "version": "1.0.0",
  "description": "Browser extension security auditing and change detection system for Google Chrome and Edge. Tracks inventory, baseline snapshots, permission drift, and risk.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "ExtensionLedger Audit",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "options_page": "dashboard/dashboard.html",
  "externally_connectable": {
    "matches": [
      "http://localhost:3000/*",
      "http://127.0.0.1:3000/*"
    ]
  },
  "permissions": [
    "management",
    "storage",
    "alarms",
    "notifications"
  ]
}
